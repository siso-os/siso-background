// The public site, background.sisolabs.space: build it with tools/site.sh, then `npx wrangler deploy` from this folder.
{
  "name": "siso-background",
  "compatibility_date": "2026-11-04",
  "assets": { "directory": "site", "html_handling": "auto-trailing-slash" },
  "routes": [{ "pattern": "background.sisolabs.space", "custom_domain": true }],
  "workers_dev": true
}
